\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces In-sample IV RMSE of the parametric, global neural, and sector neural surfaces by sector. Errors are in volatility percentage points. The sector network improved on the global neural network in every group, but technology and healthcare kept the largest errors.}}{23}{table.caption.16}\protected@file@percent }
\newlabel{tab:per_sector}{{S3}{23}{In-sample IV RMSE of the parametric, global neural, and sector neural surfaces by sector. Errors are in volatility percentage points. The sector network improved on the global neural network in every group, but technology and healthcare kept the largest errors}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces In-sample IV RMSE of the sector and per-ticker networks for the 29 qualified tickers. Rows are sorted by the reduction from the sector network to the ticker's own network. A positive reduction means the ticker's own network fitted better than its sector network. Units gives the width of each hidden layer of the ticker's own network, 16 for tickers with at least 5{,}000 observations and 8 otherwise. The 16-unit refit column repeats each 8-unit fit with 16-unit layers and the same data, seed, and training schedule. These refits served only as a diagnostic and entered no other result. The final rows count the tickers that improved and worsened and the refits that fitted better than their sector network. Two tickers, BMY and PFE, kept their sector surfaces. Combining per-ticker networks with these sector fallbacks reduced pooled RMSE from 10.24 to 9.73 volatility percentage points (Table~\ref {tab:three_way}).}}{24}{table.caption.17}\protected@file@percent }
\newlabel{tab:per_ticker_comparison}{{S4}{24}{In-sample IV RMSE of the sector and per-ticker networks for the 29 qualified tickers. Rows are sorted by the reduction from the sector network to the ticker's own network. A positive reduction means the ticker's own network fitted better than its sector network. Units gives the width of each hidden layer of the ticker's own network, 16 for tickers with at least 5{,}000 observations and 8 otherwise. The 16-unit refit column repeats each 8-unit fit with 16-unit layers and the same data, seed, and training schedule. These refits served only as a diagnostic and entered no other result. The final rows count the tickers that improved and worsened and the refits that fitted better than their sector network. Two tickers, BMY and PFE, kept their sector surfaces. Combining per-ticker networks with these sector fallbacks reduced pooled RMSE from 10.24 to 9.73 volatility percentage points (Table~\ref {tab:three_way})}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces Observed and predicted mean IV near the money in the May 11 smile panels (Fig.~\ref {fig:per_ticker_panels}). Each row averages the plotted calls and puts with $0.98\le K/S\le 1.02$ at the indicated calendar days to expiry (DTE). Predictions use the saved fifteen-date fit, evaluated at each observed contract. Observed and predicted IV are percentages. Bias is the mean per-ticker predicted IV minus observed IV, in percentage points. The NVDA subset contains only two observations. According to the public earnings calendar, GS, MSFT, and LLY reported on April 13, April 29, and April 30, 2026, respectively, all within the calibration window.}}{25}{table.caption.18}\protected@file@percent }
\newlabel{tab:smile_date_bias}{{S5}{25}{Observed and predicted mean IV near the money in the May 11 smile panels (Fig.~\ref {fig:per_ticker_panels}). Each row averages the plotted calls and puts with $0.98\le K/S\le 1.02$ at the indicated calendar days to expiry (DTE). Predictions use the saved fifteen-date fit, evaluated at each observed contract. Observed and predicted IV are percentages. Bias is the mean per-ticker predicted IV minus observed IV, in percentage points. The NVDA subset contains only two observations. According to the public earnings calendar, GS, MSFT, and LLY reported on April 13, April 29, and April 30, 2026, respectively, all within the calibration window}{table.caption.18}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces Median half-spreads and American-option pricing errors on May 11 for the contracts plotted in Fig.~\ref {fig:price_error}. Dollar values are medians across the plotted contracts. The per-ticker error is the absolute difference between the tree price using fitted IV and the market mid. Inside spread is the share of contracts whose absolute per-ticker error was at most their half-spread. The market-IV reference passed each contract's reported IV to the same 200-step CRR tree.}}{25}{table.caption.19}\protected@file@percent }
