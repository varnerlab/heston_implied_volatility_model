\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces In-sample IV RMSE of parametric and neural surfaces on 234{,}549 observations, in volatility percentage points. Each model fitted a separate level for each ticker jointly with its shape parameters. The final row used per-ticker neural surfaces for the 29 tickers with at least 2{,}000 observations and sector surfaces for PFE and BMY, which had fewer.}}{11}{table.caption.2}\protected@file@percent }
\newlabel{tab:three_way}{{1}{11}{In-sample IV RMSE of parametric and neural surfaces on 234{,}549 observations, in volatility percentage points. Each model fitted a separate level for each ticker jointly with its shape parameters. The final row used per-ticker neural surfaces for the 29 tickers with at least 2{,}000 observations and sector surfaces for PFE and BMY, which had fewer}{table.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces In-sample comparison of the implied volatility (IV) observed on May 11, 2026 with surfaces fitted across all fifteen calibration snapshots. Panels show (a) SPY, (b) NVDA, (c) MSFT, (d) LLY, (e) GS, and (f) AVGO, with 7, 7, 9, 11, 11, and 9 calendar days to expiration, respectively. Circles show reported call IV, and diamonds show reported put IV. Solid, dashed, and dotted curves show per-ticker neural, sector neural, and global parametric fits. The legend applies to all panels. The per-ticker fits for MSFT and LLY overpredict IV near the money (Supplementary Table~\ref {tab:smile_date_bias}).}}{11}{figure.caption.3}\protected@file@percent }
\newlabel{fig:per_ticker_panels}{{1}{11}{In-sample comparison of the implied volatility (IV) observed on May 11, 2026 with surfaces fitted across all fifteen calibration snapshots. Panels show (a) SPY, (b) NVDA, (c) MSFT, (d) LLY, (e) GS, and (f) AVGO, with 7, 7, 9, 11, 11, and 9 calendar days to expiration, respectively. Circles show reported call IV, and diamonds show reported put IV. Solid, dashed, and dotted curves show per-ticker neural, sector neural, and global parametric fits. The legend applies to all panels. The per-ticker fits for MSFT and LLY overpredict IV near the money (Supplementary Table~\ref {tab:smile_date_bias})}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces In-sample comparison of CRR American-option prices with Alpaca indicative mids across moneyness for SPY, NVDA, MSFT, LLY, GS, and AVGO on May 11, 2026, at the maturities of Fig.~\ref {fig:per_ticker_panels}. Errors are tree price minus indicative mid. Points show errors of prices from the parametric, sector, and per-ticker surfaces, with circles for calls and diamonds for puts. Dash-dotted curves show, for reference, errors of prices from each contract's reported IV. The gray ribbon spans plus and minus the median bid--ask half-spread in each moneyness bin. A point inside the ribbon has an absolute pricing error below the typical half-spread at that moneyness. The shares reported in the text instead compare each contract with its own half-spread.}}{12}{figure.caption.4}\protected@file@percent }
\newlabel{fig:price_error}{{2}{12}{In-sample comparison of CRR American-option prices with Alpaca indicative mids across moneyness for SPY, NVDA, MSFT, LLY, GS, and AVGO on May 11, 2026, at the maturities of Fig.~\ref {fig:per_ticker_panels}. Errors are tree price minus indicative mid. Points show errors of prices from the parametric, sector, and per-ticker surfaces, with circles for calls and diamonds for puts. Dash-dotted curves show, for reference, errors of prices from each contract's reported IV. The gray ribbon spans plus and minus the median bid--ask half-spread in each moneyness bin. A point inside the ribbon has an absolute pricing error below the typical half-spread at that moneyness. The shares reported in the text instead compare each contract with its own half-spread}{figure.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces April earnings-holdout errors for three configurations of the sector networks. Training used six snapshots labeled April 14 through April 22, 2026, and testing used April 23--24. Every test ticker appeared in training. Errors and gaps are in volatility percentage points, and each gap is test minus training RMSE, computed before rounding. Configurations A and C used the same rows and differed only in their inputs. Configuration B removed rows within three calendar days of the ticker's or a peer's earnings date. The columns $N_{\mathrm  {tr}}$ and $N_{\mathrm  {te}}$ count training and test rows. Test rows from the April 23 snapshot used the stored DTE, which counted from the April 24 download. Counting them from the April 23 session instead, with the same trained networks, gave test RMSEs of 13.22, 8.10, and 12.15 for Configurations A, B, and C.}}{12}{table.caption.5}\protected@file@percent }
\newlabel{tab:earnings_holdout}{{2}{12}{April earnings-holdout errors for three configurations of the sector networks. Training used six snapshots labeled April 14 through April 22, 2026, and testing used April 23--24. Every test ticker appeared in training. Errors and gaps are in volatility percentage points, and each gap is test minus training RMSE, computed before rounding. Configurations A and C used the same rows and differed only in their inputs. Configuration B removed rows within three calendar days of the ticker's or a peer's earnings date. The columns $N_{\mathrm {tr}}$ and $N_{\mathrm {te}}$ count training and test rows. Test rows from the April 23 snapshot used the stored DTE, which counted from the April 24 download. Counting them from the April 23 session instead, with the same trained networks, gave test RMSEs of 13.22, 8.10, and 12.15 for Configurations A, B, and C}{table.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Simulated evolution of GS stock prices (a), put values (b), and call values (c) along 1{,}000 paths between April 28 and May 29, 2026. Time is measured in calendar days from April 28. Black curves show the median at each date, and shaded bands contain the middle 90\% of values. Red curves show the median of the paths whose terminal stock price ranked in the 1st--5th percentiles, and blue curves show the median of those in the 95th--99th percentiles. Option values are dollars per share and represent the modeled cost of repurchasing the contract for a short seller. Entry premiums were \$16.51 per share for the put and \$16.09 for the call.}}{13}{figure.caption.6}\protected@file@percent }
\newlabel{fig:gs_paths}{{3}{13}{Simulated evolution of GS stock prices (a), put values (b), and call values (c) along 1{,}000 paths between April 28 and May 29, 2026. Time is measured in calendar days from April 28. Black curves show the median at each date, and shaded bands contain the middle 90\% of values. Red curves show the median of the paths whose terminal stock price ranked in the 1st--5th percentiles, and blue curves show the median of those in the 95th--99th percentiles. Option values are dollars per share and represent the modeled cost of repurchasing the contract for a short seller. Entry premiums were \$16.51 per share for the put and \$16.09 for the call}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Simulated evolution of the annualized IV of the GS put (a) and call (b) in the scenario of Fig.~\ref {fig:gs_paths}. Both panels express IV as percentages on the same vertical scale. Curves show pointwise medians across all 1{,}000 paths and within the terminal-stock groups defined in Fig.~\ref {fig:gs_paths}. Shading shows the 5th--95th percentile band across all 1{,}000 paths. Time is measured in calendar days from April 28, 2026, and stops before expiration because the payoff at expiration does not depend on IV.}}{14}{figure.caption.7}\protected@file@percent }
\newlabel{fig:gs_iv}{{4}{14}{Simulated evolution of the annualized IV of the GS put (a) and call (b) in the scenario of Fig.~\ref {fig:gs_paths}. Both panels express IV as percentages on the same vertical scale. Curves show pointwise medians across all 1{,}000 paths and within the terminal-stock groups defined in Fig.~\ref {fig:gs_paths}. Shading shows the 5th--95th percentile band across all 1{,}000 paths. Time is measured in calendar days from April 28, 2026, and stops before expiration because the payoff at expiration does not depend on IV}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Change in simulated short-option P\&L at the fixed horizon of ten trading days caused by linking IV shocks to stock returns, for (a) GS and (b) LLY. Each difference is full-factor P\&L ($\rho =-0.6$) minus uncoupled-factor P\&L ($\rho =0$) on the same stock path, with the same independent normal shocks. Negative values indicate worse short-position P\&L under coupling. The horizontal axis is each path's stock return from entry on April 28 to May 12. The 3{,}000 paths per ticker are sorted by this return and divided into ten groups of 300. Symbols show each group's median P\&L difference at its median stock return, and lines connect the symbols. Shaded bands span each group's 25th--75th percentiles. These bands describe variation across paths, not confidence intervals. Red diamonds denote puts and navy circles denote calls, as in Figs.~\ref {fig:per_ticker_panels} and~\ref {fig:price_error}. All prices are evaluated on May 12, 2026, with 17 calendar days to expiration.}}{15}{figure.caption.8}\protected@file@percent }
\newlabel{fig:dynamic_ablation}{{5}{15}{Change in simulated short-option P\&L at the fixed horizon of ten trading days caused by linking IV shocks to stock returns, for (a) GS and (b) LLY. Each difference is full-factor P\&L ($\rho =-0.6$) minus uncoupled-factor P\&L ($\rho =0$) on the same stock path, with the same independent normal shocks. Negative values indicate worse short-position P\&L under coupling. The horizontal axis is each path's stock return from entry on April 28 to May 12. The 3{,}000 paths per ticker are sorted by this return and divided into ten groups of 300. Symbols show each group's median P\&L difference at its median stock return, and lines connect the symbols. Shaded bands span each group's 25th--75th percentiles. These bands describe variation across paths, not confidence intervals. Red diamonds denote puts and navy circles denote calls, as in Figs.~\ref {fig:per_ticker_panels} and~\ref {fig:price_error}. All prices are evaluated on May 12, 2026, with 17 calendar days to expiration}{figure.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Five-session option forecasts for the shorter-maturity cohort, selected with 10--21 calendar DTE at each origin. Scores average matched options within each ticker and origin before averaging origins. The MAE scores the forecast mean. Monetary quantities (MAE, CRPS, and central 90\% interval width) are in dollars per share, and coverage is date-weighted. The column \emph  {Dates better} counts the origins on which a variant's date-level MAE was below that of frozen IV. Every IV variant uses the same stock paths, origin IV, and matched quotes.}}{16}{table.caption.9}\protected@file@percent }
\newlabel{tab:forecast_main}{{3}{16}{Five-session option forecasts for the shorter-maturity cohort, selected with 10--21 calendar DTE at each origin. Scores average matched options within each ticker and origin before averaging origins. The MAE scores the forecast mean. Monetary quantities (MAE, CRPS, and central 90\% interval width) are in dollars per share, and coverage is date-weighted. The column \emph {Dates better} counts the origins on which a variant's date-level MAE was below that of frozen IV. Every IV variant uses the same stock paths, origin IV, and matched quotes}{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Five-session forecasts of GS stock prices (a), put values (b), and call values (c), compared with observations from August 4 to August 11, 2026. The put strike is \$1{,}000, the call strike is \$1{,}105, and both options expire on August 21. Forecasts use the July-cutoff financials surface and information available at the August 4 origin. Navy curves show forecast means from 1{,}000 stock paths, with the full factor used for option values. Shading spans the central 90\% of simulated values. Red dashed curves show frozen-IV mean option forecasts on the same stock paths. Black points show observed stock closes and option midpoints, with vertical bars spanning Alpaca's indicative bid and ask for the options. Time is measured in trading sessions from the origin. August 4 was the earliest GS origin with both selected shorter-maturity options observed at the five-session endpoint.}}{16}{figure.caption.10}\protected@file@percent }
\newlabel{fig:chronological_forecast}{{6}{16}{Five-session forecasts of GS stock prices (a), put values (b), and call values (c), compared with observations from August 4 to August 11, 2026. The put strike is \$1{,}000, the call strike is \$1{,}105, and both options expire on August 21. Forecasts use the July-cutoff financials surface and information available at the August 4 origin. Navy curves show forecast means from 1{,}000 stock paths, with the full factor used for option values. Shading spans the central 90\% of simulated values. Red dashed curves show frozen-IV mean option forecasts on the same stock paths. Black points show observed stock closes and option midpoints, with vertical bars spanning Alpaca's indicative bid and ask for the options. Time is measured in trading sessions from the origin. August 4 was the earliest GS origin with both selected shorter-maturity options observed at the five-session endpoint}{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Five-session stock forecasts in 2025 and August--September 2026. Each ticker has 245 origins in 2025 and 17 in 2026. Unlike Table~\ref {tab:forecast_main}, this table's MAE scores the forecast median. Monetary quantities (MAE, CRPS, and central 90\% interval width) are in dollars per share. Scores average dates within each of three 10{,}000-path simulation seeds and then average the seeds. Adaptive volatility denotes the Gaussian model with EWMA decay $0.97$ selected on historical data. Historical selection set the direction-predicting model's drift to zero, which made it identical to the adaptive-volatility model, so the table omits it. The unchanged-price benchmark has no uncertainty interval. The last column counts origins on which the adaptive-volatility model had lower date-level CRPS than JumpHMM.}}{17}{table.caption.11}\protected@file@percent }
\newlabel{tab:stock_validation}{{4}{17}{Five-session stock forecasts in 2025 and August--September 2026. Each ticker has 245 origins in 2025 and 17 in 2026. Unlike Table~\ref {tab:forecast_main}, this table's MAE scores the forecast median. Monetary quantities (MAE, CRPS, and central 90\% interval width) are in dollars per share. Scores average dates within each of three 10{,}000-path simulation seeds and then average the seeds. Adaptive volatility denotes the Gaussian model with EWMA decay $0.97$ selected on historical data. Historical selection set the direction-predicting model's drift to zero, which made it identical to the adaptive-volatility model, so the table omits it. The unchanged-price benchmark has no uncertainty interval. The last column counts origins on which the adaptive-volatility model had lower date-level CRPS than JumpHMM}{table.caption.11}{}}
