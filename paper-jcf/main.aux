\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Forward GS share-price paths and short option premium paths for the real GS 2026-05-29 contracts, 1{,}000 simulated trajectories over 31 days. Top row: share path with $K_p = \$890$ marked (left) and short-put premium (right), with the worst 1--5\% by terminal price overlaid in red. Bottom row: share path with $K_c = \$970$ marked (left) and short-call premium (right), with the top 1--5\% by terminal price overlaid in green; the most extreme 1\% are omitted from the overlay so the figure is not dominated by spike outliers, but the underlying summary statistics use the full top 5\%. Black solid: median; shaded band: 25--75\% IQR. Blue dashed lines on the option-price panels mark the market mids received at sale (\$16.51 put, \$16.09 call).}}{23}{figure.caption.5}\protected@file@percent }
\newlabel{fig:gs_paths}{{3}{23}{Forward GS share-price paths and short option premium paths for the real GS 2026-05-29 contracts, 1{,}000 simulated trajectories over 31 days. Top row: share path with $K_p = \$890$ marked (left) and short-put premium (right), with the worst 1--5\% by terminal price overlaid in red. Bottom row: share path with $K_c = \$970$ marked (left) and short-call premium (right), with the top 1--5\% by terminal price overlaid in green; the most extreme 1\% are omitted from the overlay so the figure is not dominated by spike outliers, but the underlying summary statistics use the full top 5\%. Black solid: median; shaded band: 25--75\% IQR. Blue dashed lines on the option-price panels mark the market mids received at sale (\$16.51 put, \$16.09 call)}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Path-conditional implied volatility at the put strike (left) and call strike (right) over the 31-day horizon for the GS scenario. Both panels showed IV rising into expiry: at fixed $\log (K/S)$, shrinking $(T-t)$ moved the contract down a term structure that the per-ticker network learned to be progressively higher and steeper in the wings at short horizons. Tail-binned paths (red, green) showed an additional rise driven by $S_t$ moving away from $K$ and, on the put side, leverage coupling lifting $v_t$ on down-paths.}}{24}{figure.caption.6}\protected@file@percent }
\newlabel{fig:gs_iv}{{4}{24}{Path-conditional implied volatility at the put strike (left) and call strike (right) over the 31-day horizon for the GS scenario. Both panels showed IV rising into expiry: at fixed $\log (K/S)$, shrinking $(T-t)$ moved the contract down a term structure that the per-ticker network learned to be progressively higher and steeper in the wings at short horizons. Tail-binned paths (red, green) showed an additional rise driven by $S_t$ moving away from $K$ and, on the put side, leverage coupling lifting $v_t$ on down-paths}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Terminal P\&L distributions per contract (1{,}000 paths, log-y) for the GS scenario. Both legs showed the same short-premium pattern: most paths kept the full premium, and a long left tail held the loss-making paths. The short call's left tail was substantially fatter than the put's despite a smaller premium received.}}{24}{figure.caption.7}\protected@file@percent }
\newlabel{fig:gs_pnl}{{5}{24}{Terminal P\&L distributions per contract (1{,}000 paths, log-y) for the GS scenario. Both legs showed the same short-premium pattern: most paths kept the full premium, and a long left tail held the loss-making paths. The short call's left tail was substantially fatter than the put's despite a smaller premium received}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces LLY terminal P\&L distributions per contract (1{,}000 paths, log-y), parallel to Fig.~\ref {fig:gs_pnl}. Short put kept full premium on $77.4\%$ of paths (mean P\&L $+\$14.31$); short call kept full premium on $75.7\%$ of paths (mean P\&L $+\$6.45$) with a worst-case loss of $-\$303.88$, $1.64{\times }$ the worst put loss and $14.6{\times }$ the premium received. Full statistics in Supplementary Table~\ref {tab:lly_scenario}; share-price paths, IV trajectories, and Greek panels in the Supplementary Material.}}{25}{figure.caption.8}\protected@file@percent }
\newlabel{fig:lly_pnl}{{6}{25}{LLY terminal P\&L distributions per contract (1{,}000 paths, log-y), parallel to Fig.~\ref {fig:gs_pnl}. Short put kept full premium on $77.4\%$ of paths (mean P\&L $+\$14.31$); short call kept full premium on $75.7\%$ of paths (mean P\&L $+\$6.45$) with a worst-case loss of $-\$303.88$, $1.64{\times }$ the worst put loss and $14.6{\times }$ the premium received. Full statistics in Supplementary Table~\ref {tab:lly_scenario}; share-price paths, IV trajectories, and Greek panels in the Supplementary Material}{figure.caption.8}{}}
