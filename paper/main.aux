\newlabel{fig:lly_put_paths}{{3}{13}{Forward LLY share-price paths (left) and short put premium paths (right) for the real LLY 2026-05-29 \$825 contract, 1{,}000 simulated trajectories over 31 days. Red: worst 5\% by terminal price. Black solid: median; shaded band: 25--75\% IQR. Dotted line on the left marks the strike $K_p = \$825$; blue dashed line on the right marks the market mid received at sale, \$23.30}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Forward LLY share-price paths (left) and short call premium paths (right) for the real LLY 2026-05-29 \$940 contract. Green: top 1--5\% by terminal price; the most extreme 1\% are omitted from the overlay so the figure is not dominated by spike outliers, but the underlying summary statistics use the full top 5\%. Dotted line marks the strike $K_c = \$940$; blue dashed line marks the market mid, \$20.76.}}{13}{figure.caption.7}\protected@file@percent }
\newlabel{fig:lly_call_paths}{{4}{13}{Forward LLY share-price paths (left) and short call premium paths (right) for the real LLY 2026-05-29 \$940 contract. Green: top 1--5\% by terminal price; the most extreme 1\% are omitted from the overlay so the figure is not dominated by spike outliers, but the underlying summary statistics use the full top 5\%. Dotted line marks the strike $K_c = \$940$; blue dashed line marks the market mid, \$20.76}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Discussion and Future Work}{13}{section.6}\protected@file@percent }
\newlabel{sec:discussion}{{6}{13}{Discussion and Future Work}{section.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Path-conditional implied volatility at the put strike (left) and call strike (right) over the 31-day horizon. Both panels showed IV rising into expiry: at fixed $\log (K/S)$, shrinking $(T-t)$ pushed the standardised moneyness deeper into the wing of $\psi _{\mathrm  {NN}}$, which the per-ticker network learned to be progressively higher and steeper at short horizons. Tail-binned paths (red, green) showed an additional rise driven by $S_t$ moving away from $K$ and, on the put side, leverage coupling lifting $v_t$ on down-paths.}}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:lly_iv}{{5}{14}{Path-conditional implied volatility at the put strike (left) and call strike (right) over the 31-day horizon. Both panels showed IV rising into expiry: at fixed $\log (K/S)$, shrinking $(T-t)$ pushed the standardised moneyness deeper into the wing of $\psi _{\mathrm {NN}}$, which the per-ticker network learned to be progressively higher and steeper at short horizons. Tail-binned paths (red, green) showed an additional rise driven by $S_t$ moving away from $K$ and, on the put side, leverage coupling lifting $v_t$ on down-paths}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Leisen-Reimer American Greeks ($\Delta $, $\Gamma $, Vega) at the put and call strikes over the 31-day horizon, computed by central finite differences on the 201-step Leisen-Reimer pricer at the per-path NN-IV ($h_S = 1.5\% S_t$ for $\Delta $/$\Gamma $, $d\sigma = \pm 0.005$ for Vega). Long-Greek convention: short-position Greeks are the negatives. Top row: $\Delta $. Middle: $\Gamma $, exhibiting the short-gamma spike on paths that pinned to the strike near expiry. Bottom: Vega, decaying toward zero with $\sqrt  {T-t}$ on every path. Tail overlays as in Figs.~\ref {fig:lly_put_paths} and~\ref {fig:lly_call_paths}.}}{15}{figure.caption.9}\protected@file@percent }
\newlabel{fig:lly_greeks}{{6}{15}{Leisen-Reimer American Greeks ($\Delta $, $\Gamma $, Vega) at the put and call strikes over the 31-day horizon, computed by central finite differences on the 201-step Leisen-Reimer pricer at the per-path NN-IV ($h_S = 1.5\% S_t$ for $\Delta $/$\Gamma $, $d\sigma = \pm 0.005$ for Vega). Long-Greek convention: short-position Greeks are the negatives. Top row: $\Delta $. Middle: $\Gamma $, exhibiting the short-gamma spike on paths that pinned to the strike near expiry. Bottom: Vega, decaying toward zero with $\sqrt {T-t}$ on every path. Tail overlays as in Figs.~\ref {fig:lly_put_paths} and~\ref {fig:lly_call_paths}}{figure.caption.9}{}}
