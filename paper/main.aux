\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Terminal P\&L distributions per contract (1{,}000 paths, log-y). Both legs showed the short-premium signature: a tall spike of paths keeping the full premium, and a long left tail. The short call's left tail was substantially fatter than the put's despite a smaller premium received.}}{16}{figure.caption.10}\protected@file@percent }
\newlabel{fig:lly_pnl}{{7}{16}{Terminal P\&L distributions per contract (1{,}000 paths, log-y). Both legs showed the short-premium signature: a tall spike of paths keeping the full premium, and a long left tail. The short call's left tail was substantially fatter than the put's despite a smaller premium received}{figure.caption.10}{}}
