\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Per-ticker $\psi _{\mathrm  {NN}}$ smile fits on the eight-day pooled corpus. Representative IV smile panels at mid-DTE for six qualified tickers spanning four sectors (SPY, NVDA, MSFT, LLY, GS, AVGO). The per-ticker network (solid black) tracked the smile shape more tightly than the sector network (dashed gray) on every panel, with the largest gap on NVDA and MSFT where the shared Tech surface flattened to accommodate AVGO's elevated wings.}}{9}{figure.caption.3}\protected@file@percent }
\newlabel{fig:per_ticker_panels}{{1}{9}{Per-ticker $\psi _{\mathrm {NN}}$ smile fits on the eight-day pooled corpus. Representative IV smile panels at mid-DTE for six qualified tickers spanning four sectors (SPY, NVDA, MSFT, LLY, GS, AVGO). The per-ticker network (solid black) tracked the smile shape more tightly than the sector network (dashed gray) on every panel, with the largest gap on NVDA and MSFT where the shared Tech surface flattened to accommodate AVGO's elevated wings}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Model-vs-market dollar pricing error (CRR American at the calibrated IV minus market mid) versus moneyness for SPY, NVDA, and LLY at one representative DTE per ticker. Four model tiers are overlaid on each panel: parametric $\psi $ (light), sector $\psi _{\mathrm  {NN}}$ (medium), per-ticker $\psi _{\mathrm  {NN}}$ (dark), and market-IV reference (gray, by construction near zero). The per-ticker fit collapsed the dollar error to within \$1 of the market mid across the tradeable moneyness range on all three names.}}{9}{figure.caption.4}\protected@file@percent }
\newlabel{fig:price_error}{{2}{9}{Model-vs-market dollar pricing error (CRR American at the calibrated IV minus market mid) versus moneyness for SPY, NVDA, and LLY at one representative DTE per ticker. Four model tiers are overlaid on each panel: parametric $\psi $ (light), sector $\psi _{\mathrm {NN}}$ (medium), per-ticker $\psi _{\mathrm {NN}}$ (dark), and market-IV reference (gray, by construction near zero). The per-ticker fit collapsed the dollar error to within \$1 of the market mid across the tradeable moneyness range on all three names}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Temporal holdout and earnings-aware calibration}{10}{subsection.4.4}\protected@file@percent }
\newlabel{sec:earnings_holdout}{{4.4}{10}{Temporal holdout and earnings-aware calibration}{subsection.4.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Temporal-holdout sector-NN comparison across the three configurations. The pooled control (A) reproduced the existing four-day reference number ($13.03\%$ test RMSE on the same train/test split). Excluding earnings-window observations from both train and test (B) reduced the test RMSE to $7.96\%$ and collapsed the generalization gap from $+4.99$ to $-0.06\%$ IV. Adding the earnings indicator and peer-coupling feature to the input vector (C) on the original train and test rows reduced the pooled test RMSE to $11.98\%$ and the generalization gap to $+4.36\%$.}}{10}{table.caption.5}\protected@file@percent }
\newlabel{tab:earnings_holdout}{{2}{10}{Temporal-holdout sector-NN comparison across the three configurations. The pooled control (A) reproduced the existing four-day reference number ($13.03\%$ test RMSE on the same train/test split). Excluding earnings-window observations from both train and test (B) reduced the test RMSE to $7.96\%$ and collapsed the generalization gap from $+4.99$ to $-0.06\%$ IV. Adding the earnings indicator and peer-coupling feature to the input vector (C) on the original train and test rows reduced the pooled test RMSE to $11.98\%$ and the generalization gap to $+4.36\%$}{table.caption.5}{}}
